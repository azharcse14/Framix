{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/key.properties)",
      "Read(./**/*.p12)",
      "Read(./**/*.p8)",
      "Read(./**/*.mobileprovision)",
      "Edit(./tasks/tasks.json)",
      "Edit(./docs/TASKS.md)",
      "Bash(git push origin main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/stop-check.sh" }
        ]
      }
    ]
  }
}
